# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Web3Forms (server-side only — never expose to client)
# Get your key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Site URL (used for OG tags, sitemap, etc.)
NUXT_PUBLIC_BASE_URL=https://robertocedolin.com

# Calendly scheduling links
NUXT_PUBLIC_CALENDLY_URL=https://calendly.com/roberto-cedo
NUXT_PUBLIC_CALENDLY_60MIN_URL=https://calendly.com/roberto-cedo/60min
NUXT_PUBLIC_CALENDLY_3H_URL=https://calendly.com/roberto-cedo/3h
